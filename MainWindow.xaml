<Window x:Class="ZeroEqualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero Equalizer" Width="1040" Height="800" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#0B1018" Foreground="#E6EEF7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#121B28" />
        <SolidColorBrush x:Key="Edge" Color="#273749" />
        <SolidColorBrush x:Key="Subtle" Color="#AABBCD" />
        <SolidColorBrush x:Key="Accent" Color="#65E8CD" />
        <SolidColorBrush x:Key="Caution" Color="#F4C784" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EEF7" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6EEF7" />
            <Setter Property="Background" Value="#1B2939" />
            <Setter Property="BorderBrush" Value="#36506A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="33" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFrame" Property="BorderBrush" Value="White" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.8" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFrame" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#0C2828" />
            <Setter Property="BorderBrush" Value="#83F7DE" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6EEF7" />
            <Setter Property="Background" Value="#0D1722" />
            <Setter Property="BorderBrush" Value="#36506A" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E6EEF7" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemFrame" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#173731" /></Trigger>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#273D50" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PickerToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="PickerFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="11,0" IsHitTestVisible="False">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Width="9" Height="5" Margin="8,0,0,0" Stretch="Fill" VerticalAlignment="Center"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.5" Data="M 0 0 L 5 4 L 10 0" />
                                    <ContentPresenter x:Name="SelectionContent" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                </DockPanel>
                            </Border>
                            <TextBlock x:Name="SelectionHint" Visibility="Collapsed" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource Subtle}"
                                       Margin="11,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                        CornerRadius="7" Padding="4" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PickerFrame" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PickerFrame" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SelectionHint" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreampFader" TargetType="Slider">
            <Setter Property="Height" Value="27" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="GainTrack" Height="4" Margin="6,0" Background="#324658" CornerRadius="2" />
                            <Grid Margin="6,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Width="1" Height="12" Background="#8092A7" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="18" Cursor="SizeWE">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource Accent}" BorderBrush="#9DF7E4" BorderThickness="1" CornerRadius="4" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GainTrack" Property="Background" Value="#507C86" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BandSlider" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="TickFrequency" Value="0.5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="3" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="113" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border x:Name="FaderFocus" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" />
                            <Border Width="4" Margin="0,6" Background="#324658" CornerRadius="2" />
                            <Border Width="11" Height="1" Background="#8092A7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="12" Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Handle" CornerRadius="4" Background="{StaticResource Accent}" BorderBrush="#9DF7E4" BorderThickness="1">
                                                    <Border Height="1" Width="9" Background="#287E71" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#BAFFEF" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FaderFocus" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,19,24,20" MaxWidth="1200">
            <DockPanel Margin="0,0,0,15" LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="46" Height="46" Background="#10302F" BorderBrush="#275B54" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0">
                    <Path Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1 13 L 5 13 L 8 5 L 13 21 L 17 9 L 20 13 L 24 13" />
                </Border>
                <Border DockPanel.Dock="Right" CornerRadius="14" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        Padding="11,5" Background="{StaticResource Surface}" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadge" Text="PREVIEW" Style="{StaticResource Caption}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Zero Equalizer" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="System-wide sound shaping for Windows" Foreground="{StaticResource Subtle}" FontSize="12" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ConnectionButton" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="Connect EQ" Click="ConnectClicked" Margin="10,0,0,0" />
                        <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="Setup" Click="SetupClicked" Margin="7,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Click="RefreshClicked" Margin="7,0,0,0" />
                        <ComboBox x:Name="DevicePicker" Tag="Select an output" SelectionChanged="DeviceChanged" AutomationProperties.Name="Playback output">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock x:Name="ConnectionStatus" Margin="1,8,0,0" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="ResponseStatus" DockPanel.Dock="Right" Foreground="{StaticResource Subtle}" FontSize="12" />
                        <TextBlock Text="FREQUENCY RESPONSE" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="120" /><RowDefinition Height="19" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="GraphTop" Text="+12" Style="{StaticResource Caption}" VerticalAlignment="Top" />
                            <TextBlock x:Name="GraphMiddle" Text="0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="GraphBottom" Text="−12" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                        </Grid>
                        <Canvas x:Name="Graph" Grid.Column="1" Background="#0B141F" ClipToBounds="True" SizeChanged="GraphResized" AutomationProperties.Name="Equalizer frequency response in decibels" />
                        <Grid Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="20 Hz" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                            <TextBlock Text="632 Hz" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                            <TextBlock Text="20 kHz" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                    <Border BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="PREAMP" Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="Adjusts the overall level of the EQ manually." />
                                <TextBlock x:Name="PreampValue" Text="0.0 dB" Width="65" TextAlignment="Right" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="0 dB" Click="ResetPreampClicked" Margin="12,0,0,0" MinHeight="29"
                                    Padding="9,4" ToolTip="Reset preamp to 0 dB" AutomationProperties.Name="Reset preamp to 0 dB" />
                            <Slider x:Name="PreampSlider" Style="{StaticResource PreampFader}" Minimum="-24" Maximum="12" SmallChange="0.5" LargeChange="3"
                                    TickFrequency="0.5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="PreampChanged" AutomationProperties.Name="Manual preamp in decibels" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <TextBlock Text="±12 dB" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                        <TextBlock Text="BASS, TREBLE &amp; 10-BAND EQ" Style="{StaticResource Caption}" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="10*" /></Grid.ColumnDefinitions>
                        <UniformGrid x:Name="ToneControls" Rows="1" Margin="0,0,5,0" />
                        <Border Grid.Column="1" Background="{StaticResource Edge}" Margin="0,4" />
                        <UniformGrid x:Name="BandControls" Grid.Column="2" Rows="1" Margin="5,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="PRESETS &amp; BYPASS" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BypassButton" DockPanel.Dock="Right" Content="Bypass off" Click="BypassClicked" Margin="7,0,0,0" AutomationProperties.Name="Toggle bypass" />
                        <Button x:Name="ResetEqButton" DockPanel.Dock="Right" Content="Reset EQ" Click="ResetClicked" Margin="7,0,0,0" ToolTip="Reset Bass, Treble, and the ten bands" />
                        <Button x:Name="SavePresetButton" DockPanel.Dock="Right" Content="Save preset…" Click="SavePresetClicked" Margin="7,0,0,0" />
                        <ComboBox x:Name="PresetPicker" Tag="Custom curve" SelectionChanged="PresetChanged" AutomationProperties.Name="Equalizer preset" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
